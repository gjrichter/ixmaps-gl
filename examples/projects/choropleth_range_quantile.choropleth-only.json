{
 "metadata": {
  "title": "Test fixture for the ixmaps-gl regression harness: the map of examples/choropleth_range_quantile.html as a real ixmaps-flat project file (choropleth theme only, for loadProject(…, 'add'))"
 },
 "themes": [
  {
   "layer": "comuni",
