{
  "name": "ixmaps-gl-regression",
  "private": true,
  "description": "Output-regression harness for ixmaps-gl.js: snapshots what the engine produces per page and compares against baselines",
  "type": "module",
  "scripts": {
    "unit": "node --test 'unit/*.test.mjs'",
    "snapshot": "node run.mjs --update",
    "test": "node --test 'unit/*.test.mjs' && node run.mjs",
    "events": "node events.mjs",
    "runtime": "node runtime.mjs",
    "tools": "node tools.mjs",
    "teardown": "node teardown.mjs",
    "userchart": "node userchart.mjs"
  },
  "devDependencies": {
    "playwright": "1.62.1"
  },
  "license": "BSD-3-Clause"
}
